<local:MyCard Title="我的插件" Margin="0,0,0,15">
    <StackPanel Margin="25,38,25,15">

        <TextBlock Text="Hello, PCL!" FontSize="18" FontWeight="SemiBold" />

        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   Text="这是你的插件主界面。改 main.xaml 保存，回启动器点「重新扫描」就能看到效果。" />

        <Border Height="1" Background="{DynamicResource ColorBrushGray2}" Margin="0,16,0,16" />

        <!-- 演示：按钮 -->
        <local:MyButton x:Name="BtnDemo" Text="点我试试" Height="32" MinWidth="120"
                        HorizontalAlignment="Left" />
        <TextBlock x:Name="LabResult" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrush3}" Text="" />

        <Border Height="1" Background="{DynamicResource ColorBrushGray2}" Margin="0,16,0,16" />

        <!-- 演示：输入框 -->
        <TextBlock Text="输入点什么" Margin="0,0,0,6" />
        <local:MyTextBox x:Name="TextInput" Height="32" HintText="在这里打字" />

    </StackPanel>
</local:MyCard>
